{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m3_acoustic_material_database_v2.schema.json",
  "title": "AVEngine M3 RLR-native Acoustic Material Database v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "database_id",
    "version",
    "coefficient_units",
    "provenance",
    "materials"
  ],
  "properties": {
    "schema": {
      "const": "avengine_m3_acoustic_material_database_v2"
    },
    "database_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "coefficient_units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absorption",
        "scattering",
        "transmission",
        "damping",
        "density",
        "speed"
      ],
      "properties": {
        "absorption": {
          "const": "frequency_hz_fraction_of_incident_sound_pressure_interleaved"
        },
        "scattering": {
          "const": "frequency_hz_fraction_of_incident_sound_pressure_interleaved"
        },
        "transmission": {
          "const": "frequency_hz_fraction_of_incident_sound_pressure_interleaved"
        },
        "damping": {
          "const": "frequency_hz_decibels_per_meter_interleaved"
        },
        "density": {
          "const": "kilograms_per_cubic_meter"
        },
        "speed": {
          "const": "meters_per_second"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence",
        "material_semantics",
        "intended_use"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "material_semantics": {
          "enum": [
            "reviewed_physical",
            "research_placeholder"
          ]
        },
        "intended_use": {
          "enum": [
            "reviewed_production_profile",
            "research_compiler_diagnostics"
          ]
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_key",
          "name",
          "labels",
          "absorption",
          "scattering",
          "transmission",
          "damping",
          "density",
          "speed",
          "source",
          "confidence"
        ],
        "properties": {
          "material_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "absorption": {
            "$ref": "#/$defs/interleaved_curve"
          },
          "scattering": {
            "$ref": "#/$defs/interleaved_curve"
          },
          "transmission": {
            "$ref": "#/$defs/interleaved_curve"
          },
          "damping": {
            "$ref": "#/$defs/interleaved_curve"
          },
          "density": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "interleaved_curve": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number"
      }
    }
  }
}
