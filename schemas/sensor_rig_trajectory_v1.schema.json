{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/sensor_rig_trajectory_v1.schema.json",
  "title": "AVEngine Sensor Rig Trajectory v1",
  "description": "One deterministic five-second yaw-only trajectory for the formal co-located camera/listener rig.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trajectory_id",
    "rig_id",
    "formal_view_id",
    "listener_id",
    "coordinate_frame",
    "camera_listener_coupling",
    "rig_from_camera",
    "rig_from_listener",
    "pose_model",
    "pose_hash_algorithm",
    "time_base_hz",
    "duration_ticks",
    "frame_rate_hz",
    "frame_count",
    "ticks_per_frame",
    "program",
    "frames"
  ],
  "properties": {
    "schema": {"const": "avengine_sensor_rig_trajectory_v1"},
    "trajectory_id": {"$ref": "#/$defs/stable_id"},
    "rig_id": {"const": "camera_rig_0"},
    "formal_view_id": {"const": "view0"},
    "listener_id": {"const": "listener0"},
    "coordinate_frame": {"const": "avengine_world_right_handed_y_up_m"},
    "camera_listener_coupling": {
      "const": "rigid_colocated_cooriented"
    },
    "rig_from_camera": {"$ref": "#/$defs/identity_transform"},
    "rig_from_listener": {"$ref": "#/$defs/identity_transform"},
    "pose_model": {"const": "yaw_only_about_world_positive_y"},
    "pose_hash_algorithm": {"const": "avengine_sensor_rig_pose_hash_v1"},
    "time_base_hz": {"const": 48000},
    "duration_ticks": {"const": 240000},
    "frame_rate_hz": {"const": 15},
    "frame_count": {"const": 75},
    "ticks_per_frame": {"const": 3200},
    "program": {
      "oneOf": [
        {"$ref": "#/$defs/hold_program"},
        {"$ref": "#/$defs/rotate_program"},
        {"$ref": "#/$defs/polyline_move_program"},
        {"$ref": "#/$defs/geodesic_move_program"},
        {"$ref": "#/$defs/waypoint_route_program"}
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 75,
      "maxItems": 75,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "quat_xyzw": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_m", "rotation_xyzw"],
      "properties": {
        "translation_m": {"$ref": "#/$defs/vec3"},
        "rotation_xyzw": {"$ref": "#/$defs/quat_xyzw"}
      }
    },
    "identity_transform": {
      "const": {
        "translation_m": [0.0, 0.0, 0.0],
        "rotation_xyzw": [0.0, 0.0, 0.0, 1.0]
      }
    },
    "hold_program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position_m", "yaw_deg"],
      "properties": {
        "kind": {"const": "HOLD"},
        "position_m": {"$ref": "#/$defs/vec3"},
        "yaw_deg": {"type": "number"}
      }
    },
    "rotate_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position_m",
        "start_yaw_deg",
        "end_yaw_deg",
        "yaw_interpolation"
      ],
      "properties": {
        "kind": {"const": "ROTATE_IN_PLACE"},
        "position_m": {"$ref": "#/$defs/vec3"},
        "start_yaw_deg": {"type": "number"},
        "end_yaw_deg": {"type": "number"},
        "yaw_interpolation": {"const": "SHORTEST_ARC"}
      }
    },
    "move_heading_policy": {
      "enum": ["FIXED_YAW", "PATH_TANGENT_KEEP_LAST_ON_HOLD"]
    },
    "polyline_move_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path_points_m",
        "position_interpolation",
        "heading_policy",
        "initial_yaw_deg"
      ],
      "properties": {
        "kind": {"const": "POLYLINE_MOVE"},
        "path_points_m": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/vec3"}
        },
        "position_interpolation": {"const": "ARC_LENGTH"},
        "heading_policy": {"$ref": "#/$defs/move_heading_policy"},
        "initial_yaw_deg": {"type": "number"}
      }
    },
    "geodesic_move_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path_points_m",
        "pathfinder_evidence_ref",
        "position_interpolation",
        "heading_policy",
        "initial_yaw_deg"
      ],
      "properties": {
        "kind": {"const": "GEODESIC_MOVE"},
        "path_points_m": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/vec3"}
        },
        "pathfinder_evidence_ref": {"type": "string", "minLength": 1},
        "position_interpolation": {"const": "ARC_LENGTH"},
        "heading_policy": {"$ref": "#/$defs/move_heading_policy"},
        "initial_yaw_deg": {"type": "number"}
      }
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "position_m", "yaw_deg"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 74},
        "position_m": {"$ref": "#/$defs/vec3"},
        "yaw_deg": {"type": "number"}
      }
    },
    "waypoint_route_program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "waypoints", "interpolation"],
      "properties": {
        "kind": {"const": "WAYPOINT_ROUTE"},
        "waypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 75,
          "items": {"$ref": "#/$defs/waypoint"}
        },
        "interpolation": {
          "const": "LINEAR_POSITION_SHORTEST_YAW"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index",
        "pts_ticks",
        "world_from_rig",
        "pose_hash"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 74},
        "pts_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 236800,
          "multipleOf": 3200
        },
        "world_from_rig": {"$ref": "#/$defs/transform"},
        "pose_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
