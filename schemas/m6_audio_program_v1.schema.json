{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m6_audio_program_v1.schema.json",
  "title": "AVEngine M6 Audio Program v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "program_id", "revision", "mode", "timeline", "candidate_source_endpoint_ids",
    "events", "source_specific_stems", "admission_state", "program_content_sha256"
  ],
  "properties": {
    "schema": {"const": "avengine_m6_audio_program_v1"},
    "program_id": {"$ref": "#/$defs/stable_id"},
    "revision": {"$ref": "#/$defs/stable_id"},
    "mode": {
      "enum": [
        "one_active_of_n",
        "simultaneous_subset",
        "sequential_sources",
        "intermittent_events",
        "counterfactual_route_swap",
        "silent_negative"
      ]
    },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["time_base_hz", "ticks_per_frame", "video_fps", "frame_count", "sample_rate_hz", "ticks_per_sample", "sample_count"],
      "properties": {
        "time_base_hz": {"const": 48000},
        "ticks_per_frame": {"const": 3200},
        "video_fps": {"const": 15},
        "frame_count": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"const": 16000},
        "ticks_per_sample": {"const": 3},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "candidate_source_endpoint_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "source_specific_stems": {"type": "boolean"},
    "source_program_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream_program_id", "upstream_source_id", "upstream_request_uri", "upstream_request_sha256"],
      "properties": {
        "upstream_program_id": {"$ref": "#/$defs/stable_id"},
        "upstream_source_id": {"$ref": "#/$defs/stable_id"},
        "upstream_request_uri": {"type": "string", "minLength": 1},
        "upstream_request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "variants", "reference_variant", "mapped_variant",
        "endpoint_permutation", "allowed_changed_fields"
      ],
      "properties": {
        "operation": {"const": "swap_source_endpoint_routing"},
        "variants": {"const": ["A", "B"]},
        "reference_variant": {"const": "A"},
        "mapped_variant": {"const": "B"},
        "endpoint_permutation": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"$ref": "#/$defs/stable_id"},
          "additionalProperties": {"$ref": "#/$defs/stable_id"}
        },
        "allowed_changed_fields": {
          "const": ["events[*].source_endpoint_id"]
        }
      }
    },
    "admission_state": {"enum": ["formal", "research"]},
    "program_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": [
        "event_id", "source_endpoint_id", "sound_asset_id",
        "start_tick", "end_tick_exclusive", "start_sample", "end_sample_exclusive",
        "source_start_sample", "source_end_sample_exclusive", "linear_gain", "fade_samples",
        "normalization_policy", "render_source_stem"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/stable_id"},
        "source_endpoint_id": {"$ref": "#/$defs/stable_id"},
        "sound_asset_id": {"$ref": "#/$defs/stable_id"},
        "upstream_window_id": {"$ref": "#/$defs/stable_id"},
        "start_tick": {"type": "integer", "minimum": 0},
        "end_tick_exclusive": {"type": "integer", "minimum": 1},
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample_exclusive": {"type": "integer", "minimum": 1},
        "source_start_sample": {"type": "integer", "minimum": 0},
        "source_end_sample_exclusive": {"type": "integer", "minimum": 1},
        "linear_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "fade_samples": {"type": "integer", "minimum": 0},
        "normalization_policy": {"const": "use_sound_asset_policy"},
        "render_source_stem": {"type": "boolean"}
      }
    }
  }
}
