{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schemas/avengine_native_paper_balance_gpu_plan_revision_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "qualification_claim",
    "base_plan",
    "reason",
    "superseded_gpu_policy",
    "active_gpu_policy",
    "unchanged_contracts"
  ],
  "properties": {
    "schema": {"const": "avengine_native_paper_balance_gpu_plan_revision_v1"},
    "status": {"const": "active_pending_idle_gate"},
    "qualification_claim": {"const": false},
    "base_plan": {"const": "examples/qa/native_paper_balance_episode_plan_v1.json"},
    "reason": {"const": "external_long_running_compute_on_physical_gpu2_no_preemption"},
    "superseded_gpu_policy": {
      "const": {
        "physical_gpu_index": 2,
        "require_idle_before_launch": true,
        "forbidden_gpu_indices": [0, 3]
      }
    },
    "active_gpu_policy": {
      "const": {
        "physical_gpu_index": 1,
        "require_idle_before_launch": true,
        "forbidden_gpu_indices": [0, 3]
      }
    },
    "unchanged_contracts": {
      "const": [
        "native_spear_unreal_engine_renderer",
        "native_apartment_geometry",
        "metric_depth_target_only_authority",
        "question_answer_thresholds"
      ]
    }
  }
}
