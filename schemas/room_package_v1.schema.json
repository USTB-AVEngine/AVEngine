{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/room_package_v1.schema.json",
  "title": "AVEngine Room Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "room_id",
    "room_kind",
    "geometry_representation",
    "coordinate_system",
    "scene",
    "assets",
    "semantics",
    "navigation",
    "openings",
    "connectivity_pairs",
    "ray_checks",
    "acoustics",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "avengine_room_package_v1"},
    "room_id": {"type": "string", "minLength": 1},
    "room_kind": {
      "enum": [
        "habitat_native",
        "blender_custom",
        "legacy_ue_real_surface_export",
        "external_usd_real_surface"
      ]
    },
    "geometry_representation": {
      "enum": ["real_surface_mesh", "debug_aabb_proxy"]
    },
    "coordinate_system": {"$ref": "#/$defs/coordinate_system"},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id_kind",
        "scene_id",
        "dataset_config_path",
        "navmesh_path",
        "navmesh_policy",
        "load_semantic_mesh",
        "enable_physics"
      ],
      "properties": {
        "scene_id_kind": {"enum": ["path", "handle"]},
        "scene_id": {"type": "string", "minLength": 1},
        "dataset_config_path": {"type": "string", "minLength": 1},
        "navmesh_path": {"type": "string", "minLength": 1},
        "navmesh_policy": {
          "enum": ["load_declared", "recompute_if_missing"]
        },
        "load_semantic_mesh": {"type": "boolean"},
        "enable_physics": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "license": {"type": "string"},
          "redistribution": {"type": "string"}
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation"],
      "properties": {
        "interpretation": {"type": "string", "minLength": 1},
        "id_to_label": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_height_m", "agent_radius_m", "include_static_objects"],
      "properties": {
        "agent_height_m": {"type": "number", "exclusiveMinimum": 0},
        "agent_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "include_static_objects": {"type": "boolean"}
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opening_id", "kind", "description"],
        "properties": {
          "opening_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["door", "window", "archway", "other"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "connectivity_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/connectivity_pair"}
    },
    "ray_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/ray_check"}
    },
    "acoustics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "deferred_to_m3"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "source_revision"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}
      }
    },
    "surface_audit": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "room_kind": {
            "enum": [
              "blender_custom",
              "legacy_ue_real_surface_export",
              "external_usd_real_surface"
            ]
          }
        }
      },
      "then": {
        "required": ["surface_audit"],
        "properties": {
          "geometry_representation": {"const": "real_surface_mesh"}
        }
      }
    }
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handedness",
        "up_axis",
        "forward_axis",
        "linear_unit",
        "quaternion_order"
      ],
      "properties": {
        "handedness": {"const": "right"},
        "up_axis": {"const": "+Y"},
        "forward_axis": {"const": "-Z"},
        "linear_unit": {"const": "meter"},
        "quaternion_order": {"const": "xyzw"}
      }
    },
    "connectivity_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "start_m", "end_m"],
      "properties": {
        "pair_id": {"type": "string", "minLength": 1},
        "start_m": {"$ref": "#/$defs/vec3"},
        "end_m": {"$ref": "#/$defs/vec3"}
      }
    },
    "ray_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "origin_m",
        "direction",
        "expectation",
        "distance_m"
      ],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "origin_m": {"$ref": "#/$defs/vec3"},
        "direction": {"$ref": "#/$defs/vec3"},
        "expectation": {"enum": ["clear_until_m", "hit_within_m"]},
        "distance_m": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
