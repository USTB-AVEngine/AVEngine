{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m6_entity_asset_registry_v1.schema.json",
  "title": "AVEngine M6 Entity Asset Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "revision", "entities", "registry_content_sha256"],
  "properties": {
    "schema": {"const": "avengine_m6_entity_asset_registry_v1"},
    "registry_id": {"$ref": "#/$defs/stable_id"},
    "revision": {"$ref": "#/$defs/stable_id"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "registry_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": {
          "enum": [
            "emitter_marker_glb",
            "marker_visual_approval",
            "spear_static_admission_batch",
            "spear_static_admission_job_receipt",
            "spear_static_emitter_stage_receipt",
            "spear_static_finalization_stage_receipt",
            "spear_static_watertight_stage_receipt",
            "visual_asset_glb"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "static_object_admission_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "pipeline",
        "status",
        "identity",
        "coordinate_system_id",
        "emitter_anchor_id",
        "artifacts",
        "formal_dataset_registration_authorized",
        "evidence_content_sha256"
      ],
      "properties": {
        "schema": {
          "const": "avengine_m6_static_object_admission_evidence_v1"
        },
        "pipeline": {"const": "spear_flux2_pixal3d_static_v1"},
        "status": {"const": "passed_research_registration"},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_id", "request_sha256", "profile_sha256"],
          "properties": {
            "instance_id": {"$ref": "#/$defs/stable_id"},
            "request_sha256": {"$ref": "#/$defs/sha256"},
            "profile_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "coordinate_system_id": {
          "const": "avengine_local_x_forward_y_up_z_right_m"
        },
        "emitter_anchor_id": {"$ref": "#/$defs/stable_id"},
        "artifacts": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/evidence_artifact"}
        },
        "formal_dataset_registration_authorized": {"const": false},
        "evidence_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "anchor_type", "joint_id", "local_position_m"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/stable_id"},
        "anchor_type": {
          "enum": ["head", "mouth", "muzzle", "paw", "body", "object_speaker", "environmental_point", "offscreen_point"]
        },
        "joint_id": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "local_position_m": {"$ref": "#/$defs/vec3"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_revision", "license", "rights_status", "evidence_sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "license": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "rights_status": {"enum": ["licensed", "research_use_only", "review_required", "unresolved"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_asset_id",
        "revision",
        "entity_class",
        "visual_asset",
        "realized_visual_attributes",
        "capabilities",
        "emitter_anchors",
        "provenance",
        "admission_state"
      ],
      "properties": {
        "entity_asset_id": {"$ref": "#/$defs/stable_id"},
        "revision": {"$ref": "#/$defs/stable_id"},
        "entity_class": {
          "enum": ["articulated_human", "articulated_animal", "rigid_object", "articulated_object", "environmental_emitter", "offscreen_emitter"]
        },
        "visual_asset": {"$ref": "#/$defs/artifact"},
        "animal_template_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template_id", "revision"],
          "properties": {
            "template_id": {"$ref": "#/$defs/stable_id"},
            "revision": {"$ref": "#/$defs/stable_id"}
          }
        },
        "realized_visual_attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["articulated", "skeleton_revision", "action_ids"],
          "properties": {
            "articulated": {"type": "boolean"},
            "skeleton_revision": {"oneOf": [{"$ref": "#/$defs/stable_id"}, {"type": "null"}]},
            "skeleton_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "action_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/stable_id"}
            }
          }
        },
        "emitter_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/anchor"}
        },
        "admission_evidence": {
          "$ref": "#/$defs/static_object_admission_evidence"
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "admission_state": {"enum": ["formal", "research", "unavailable", "rejected"]}
      },
      "allOf": [
        {
          "if": {"properties": {"entity_class": {"const": "articulated_animal"}}},
          "then": {"required": ["animal_template_ref"]}
        },
        {
          "if": {"required": ["admission_evidence"]},
          "then": {
            "properties": {
              "entity_class": {"const": "rigid_object"},
              "admission_state": {"const": "research"},
              "realized_visual_attributes": {
                "required": [
                  "source_instance_id",
                  "formal_dataset_registration_authorized"
                ],
                "properties": {
                  "source_instance_id": {"$ref": "#/$defs/stable_id"},
                  "formal_dataset_registration_authorized": {"const": false}
                }
              },
              "capabilities": {
                "required": [
                  "articulated",
                  "skeleton_revision",
                  "skeleton_sha256",
                  "action_ids"
                ],
                "properties": {
                  "articulated": {"const": false},
                  "skeleton_revision": {"type": "null"},
                  "skeleton_sha256": {"type": "null"},
                  "action_ids": {"maxItems": 0}
                }
              },
              "emitter_anchors": {
                "minItems": 1,
                "maxItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "anchor_type": {"const": "object_speaker"},
                    "joint_id": {"type": "null"}
                  },
                  "required": ["anchor_type", "joint_id"]
                }
              }
            }
          }
        }
      ]
    }
  }
}
