{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/avengine_release_attestation_v1.schema.json",
  "title": "AVEngine Post-Tag Release Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "release_id",
    "release_tag",
    "release_tag_commit",
    "implementation_commit",
    "manifest",
    "verification_command",
    "verification_report"
  ],
  "properties": {
    "schema": {
      "const": "avengine_release_attestation_v1"
    },
    "status": {
      "const": "pass"
    },
    "release_id": {
      "$ref": "#/$defs/stableId"
    },
    "release_tag": {
      "type": "string",
      "minLength": 1
    },
    "release_tag_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "implementation_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "manifest": {
      "$ref": "#/$defs/fileRecord"
    },
    "verification_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_report": {
      "$ref": "#/$defs/verificationReport"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "path",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "root_id": {
          "const": "avengine"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "errors"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "pass"
        },
        "errors": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verificationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "checks",
        "observed"
      ],
      "properties": {
        "schema": {
          "const": "avengine_release_verification_v1"
        },
        "status": {
          "const": "pass"
        },
        "checks": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verificationCheck"
          }
        },
        "observed": {
          "type": "object",
          "required": [
            "manifest_file_record",
            "avengine_metadata_commit",
            "avengine_metadata_parent",
            "avengine_metadata_parent_count",
            "release_tag_commit",
            "habitat_runtime_commit",
            "rlr_commit"
          ],
          "properties": {
            "manifest_file_record": {
              "$ref": "#/$defs/fileRecord"
            },
            "avengine_metadata_commit": {
              "$ref": "#/$defs/gitCommit"
            },
            "avengine_metadata_parent": {
              "$ref": "#/$defs/gitCommit"
            },
            "avengine_metadata_parent_count": {
              "const": 1
            },
            "release_tag_commit": {
              "$ref": "#/$defs/gitCommit"
            },
            "habitat_runtime_commit": {
              "$ref": "#/$defs/gitCommit"
            },
            "rlr_commit": {
              "$ref": "#/$defs/gitCommit"
            }
          }
        }
      }
    }
  }
}
