{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m3_compile_evidence_v1.schema.json",
  "title": "AVEngine M3 Compiler Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "request_id",
    "request_sha256",
    "source_inputs",
    "packages",
    "frozen_variable_proof",
    "material_counterfactual_proof",
    "runtime_material_activation",
    "evidence_content_sha256"
  ],
  "properties": {
    "schema": {"const": "avengine_m3_compile_evidence_v1"},
    "status": {"const": "pass"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "source_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "room_manifest",
        "material_mapping",
        "low_database",
        "high_database",
        "source_geometry"
      ],
      "properties": {
        "request": {"$ref": "#/$defs/source_input"},
        "room_manifest": {"$ref": "#/$defs/source_input"},
        "material_mapping": {"$ref": "#/$defs/source_input"},
        "low_database": {"$ref": "#/$defs/source_input"},
        "high_database": {"$ref": "#/$defs/source_input"},
        "source_geometry": {"$ref": "#/$defs/source_input"}
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low_absorption", "high_absorption"],
      "properties": {
        "low_absorption": {"$ref": "#/$defs/package"},
        "high_absorption": {"$ref": "#/$defs/package"}
      }
    },
    "frozen_variable_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices", "triangles", "triangle_material_ids"],
      "properties": {
        "vertices": {"$ref": "#/$defs/invariant"},
        "triangles": {"$ref": "#/$defs/invariant"},
        "triangle_material_ids": {"$ref": "#/$defs/invariant"}
      }
    },
    "material_counterfactual_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allowed_differences",
        "non_absorption_structure",
        "every_high_absorption_band_strictly_greater",
        "materials",
        "errors"
      ],
      "properties": {
        "status": {"const": "pass"},
        "allowed_differences": {
          "type": "array",
          "prefixItems": [
            {"const": "database_id"},
            {"const": "materials[*].absorption"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "non_absorption_structure": {"$ref": "#/$defs/invariant"},
        "every_high_absorption_band_strictly_greater": {"const": true},
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "material_key",
              "low_absorption",
              "high_absorption",
              "high_strictly_greater_every_band"
            ],
            "properties": {
              "material_key": {"type": "string", "minLength": 1},
              "low_absorption": {"$ref": "#/$defs/coefficients"},
              "high_absorption": {"$ref": "#/$defs/coefficients"},
              "high_strictly_greater_every_band": {"const": true}
            }
          }
        },
        "errors": {"type": "array", "maxItems": 0}
      }
    },
    "runtime_material_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "not_run"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidence_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byte_size",
        "sha256",
        "package_content_sha256"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "package_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low_sha256", "high_sha256", "identical"],
      "properties": {
        "low_sha256": {"$ref": "#/$defs/sha256"},
        "high_sha256": {"$ref": "#/$defs/sha256"},
        "identical": {"const": true}
      }
    },
    "coefficients": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
