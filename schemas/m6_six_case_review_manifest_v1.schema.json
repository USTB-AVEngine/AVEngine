{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schemas/m6_six_case_review_manifest_v1.schema.json",
  "title": "AVEngine M6 six-case human review manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "request",
    "output_profile",
    "case_semantics",
    "segments",
    "combined_video",
    "tool_versions"
  ],
  "properties": {
    "schema": {"const": "avengine_m6_six_case_review_manifest_v1"},
    "review_id": {"$ref": "#/$defs/id"},
    "request": {"$ref": "#/$defs/artifact"},
    "output_profile": {"type": "object"},
    "case_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "real_room_lineage_count",
        "mp3d_raw_derived_share_visual",
        "corrupted_fixture_is_room"
      ],
      "properties": {
        "case_count": {"const": 6},
        "real_room_lineage_count": {"const": 4},
        "mp3d_raw_derived_share_visual": {"const": true},
        "corrupted_fixture_is_room": {"const": false}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/segment"}
    },
    "combined_video": {"$ref": "#/$defs/mediaArtifact"},
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg", "ffprobe"],
      "properties": {
        "ffmpeg": {"type": "string", "minLength": 1},
        "ffprobe": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "video_codec",
        "width",
        "height",
        "frame_rate_hz",
        "audio_codec",
        "audio_sample_rate_hz",
        "audio_channel_count"
      ],
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "video_codec": {"const": "h264"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "audio_codec": {"const": "aac"},
        "audio_sample_rate_hz": {"type": "integer", "minimum": 1},
        "audio_channel_count": {"const": 2}
      }
    },
    "mediaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256", "probe"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "probe": {"$ref": "#/$defs/probe"}
      }
    },
    "inputMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "render_mode"],
      "properties": {
        "availability": {"enum": ["available", "shared", "pending", "unavailable", "not_applicable"]},
        "render_mode": {"enum": ["source_media", "shared_source_media", "placeholder", "source_audio", "silent_unavailable"]},
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "reuse_from_case_id": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_tier": {"enum": ["qualified", "research_only", "unqualified", "not_applicable"]}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "case_id",
        "role",
        "case_kind",
        "title",
        "is_room",
        "status",
        "visual_input",
        "audio_input",
        "title_lines",
        "rendered_segment"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 6},
        "case_id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "case_kind": {"enum": ["room_review", "acoustic_representation_review", "diagnostic_negative"]},
        "title": {"type": "string", "minLength": 1},
        "is_room": {"type": "boolean"},
        "room_id": {"$ref": "#/$defs/id"},
        "room_lineage_id": {"$ref": "#/$defs/id"},
        "status": {"type": "object"},
        "visual_input": {"$ref": "#/$defs/inputMedia"},
        "audio_input": {"$ref": "#/$defs/inputMedia"},
        "title_lines": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "rendered_segment": {"$ref": "#/$defs/mediaArtifact"}
      }
    }
  }
}
