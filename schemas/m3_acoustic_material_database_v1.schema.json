{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m3_acoustic_material_database_v1.schema.json",
  "title": "AVEngine M3 Acoustic Material Database v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "database_id",
    "version",
    "bands_hz",
    "coefficient_units",
    "provenance",
    "materials"
  ],
  "properties": {
    "schema": {"const": "avengine_m3_acoustic_material_database_v1"},
    "database_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "bands_hz": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "coefficient_units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absorption",
        "scattering",
        "transmission",
        "damping",
        "density",
        "speed"
      ],
      "properties": {
        "absorption": {"const": "fraction_of_incident_sound_pressure"},
        "scattering": {"const": "fraction_of_incident_sound_pressure"},
        "transmission": {"const": "fraction_of_incident_sound_pressure"},
        "damping": {"const": "decibels_per_meter"},
        "density": {"const": "kilograms_per_cubic_meter"},
        "speed": {"const": "meters_per_second"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence",
        "material_semantics",
        "intended_use"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "material_semantics": {
          "enum": [
            "controlled_canary",
            "reviewed_physical",
            "research_placeholder"
          ]
        },
        "intended_use": {
          "enum": [
            "controlled_material_activation_canary",
            "reviewed_production_profile",
            "research_compiler_diagnostics"
          ]
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_key",
          "name",
          "labels",
          "absorption",
          "scattering",
          "transmission",
          "damping",
          "density",
          "speed",
          "source",
          "confidence"
        ],
        "properties": {
          "material_key": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "labels": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "absorption": {"$ref": "#/$defs/coefficient_values"},
          "scattering": {"$ref": "#/$defs/coefficient_values"},
          "transmission": {"$ref": "#/$defs/coefficient_values"},
          "damping": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number", "minimum": 0}
          },
          "density": {"type": "number", "exclusiveMinimum": 0},
          "speed": {"type": "number", "exclusiveMinimum": 0},
          "source": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "coefficient_values": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
