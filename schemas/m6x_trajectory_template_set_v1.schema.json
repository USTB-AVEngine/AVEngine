{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m6x_trajectory_template_set_v1.schema.json",
  "title": "AVEngine M6.x Sparse Trajectory Template Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trajectory_template_set_id",
    "revision",
    "room_capsule_ref",
    "anchor_library_ref",
    "frame_rate_hz",
    "frame_count",
    "templates",
    "execution_status"
  ],
  "properties": {
    "schema": {"const": "avengine_m6x_trajectory_template_set_v1"},
    "trajectory_template_set_id": {"$ref": "#/$defs/stable_id"},
    "revision": {"$ref": "#/$defs/stable_id"},
    "room_capsule_ref": {"$ref": "#/$defs/room_ref"},
    "anchor_library_ref": {"$ref": "#/$defs/anchor_ref"},
    "frame_rate_hz": {"const": 15},
    "frame_count": {"type": "integer", "minimum": 2},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/template"}
    },
    "execution_status": {"$ref": "#/$defs/execution_status"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "room_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room_capsule_id", "revision"],
      "properties": {
        "room_capsule_id": {"$ref": "#/$defs/stable_id"},
        "revision": {"$ref": "#/$defs/stable_id"}
      }
    },
    "anchor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_library_id", "revision"],
      "properties": {
        "anchor_library_id": {"$ref": "#/$defs/stable_id"},
        "revision": {"$ref": "#/$defs/stable_id"}
      }
    },
    "execution_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["run", "pass", "blocked", "not_run"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "blocked"}},
            "required": ["state"]
          },
          "then": {"required": ["reason", "evidence_refs"]}
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "anchor_ids", "anchor_frame_indices", "interpolation"],
      "properties": {
        "route_id": {"$ref": "#/$defs/stable_id"},
        "anchor_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "anchor_frame_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "interpolation": {
          "enum": ["hold", "piecewise_linear", "navmesh_follow"]
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "kind", "heading_policy", "routes", "execution_status"],
      "properties": {
        "template_id": {"$ref": "#/$defs/stable_id"},
        "kind": {"enum": ["static", "linear", "crossing_pair", "navmesh_follow"]},
        "heading_policy": {"const": "path_tangent_keep_last_on_hold"},
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/route"}
        },
        "execution_status": {"$ref": "#/$defs/execution_status"}
      }
    }
  }
}
