{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m6_derived_acoustic_proxy_v1.schema.json",
  "title": "AVEngine M6 Derived Acoustic Proxy Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proxy_id",
    "revision",
    "room_id",
    "representation_id",
    "artifact_uri",
    "source",
    "derivation",
    "package",
    "qualification_claim",
    "dataset_admission",
    "descriptor_content_sha256"
  ],
  "properties": {
    "schema": {"const": "avengine_m6_derived_acoustic_proxy_v1"},
    "proxy_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "room_id": {"type": "string", "minLength": 1},
    "representation_id": {"type": "string", "minLength": 1},
    "artifact_uri": {"type": "string", "pattern": "^artifact://"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "representation_id",
        "sha256",
        "raw_package_manifest_sha256"
      ],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "representation_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "raw_package_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "policy",
        "record_content_sha256",
        "removed_triangle_count",
        "removed_triangle_indices_sha256",
        "removed_triangle_area_max_m2",
        "source_triangle_count",
        "derived_triangle_count",
        "source_array_hashes",
        "derived_array_hashes"
      ],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1},
        "record_content_sha256": {"$ref": "#/$defs/sha256"},
        "removed_triangle_count": {"type": "integer", "minimum": 1},
        "removed_triangle_indices_sha256": {"$ref": "#/$defs/sha256"},
        "removed_triangle_area_max_m2": {"type": "number", "minimum": 0},
        "source_triangle_count": {"type": "integer", "minimum": 1},
        "derived_triangle_count": {"type": "integer", "minimum": 1},
        "source_array_hashes": {"$ref": "#/$defs/arrayHashes"},
        "derived_array_hashes": {"$ref": "#/$defs/arrayHashes"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "package_id",
        "package_content_sha256",
        "manifest",
        "artifacts",
        "artifact_set_sha256"
      ],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "package_id": {"type": "string", "minLength": 1},
        "package_content_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/fileRecord"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileRecord"}
        },
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualification_claim": {"const": false},
    "dataset_admission": {"const": false},
    "descriptor_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrayHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices", "triangles", "triangle_material_ids"],
      "properties": {
        "vertices": {"$ref": "#/$defs/sha256"},
        "triangles": {"$ref": "#/$defs/sha256"},
        "triangle_material_ids": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
