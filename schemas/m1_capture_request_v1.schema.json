{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m1_capture_request_v1.schema.json",
  "title": "AVEngine M1 Single-View Multimodal Capture Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "room_id",
    "seed",
    "primary_camera_rig",
    "listener",
    "sources",
    "qa_views"
  ],
  "properties": {
    "schema": {"const": "avengine_m1_capture_request_v1"},
    "request_id": {"type": "string", "minLength": 1},
    "room_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "primary_camera_rig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rig_id",
        "view_id",
        "world_from_rig",
        "shared_calibration",
        "modalities"
      ],
      "properties": {
        "rig_id": {"const": "camera_rig_0"},
        "view_id": {"const": "view0"},
        "world_from_rig": {"$ref": "#/$defs/transform"},
        "shared_calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection",
            "resolution_hw",
            "hfov_degrees",
            "near_m",
            "far_m",
            "rig_from_sensor"
          ],
          "properties": {
            "projection": {"const": "pinhole"},
            "resolution_hw": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {"type": "integer", "minimum": 1},
                {"type": "integer", "minimum": 1}
              ],
              "items": false
            },
            "hfov_degrees": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            },
            "near_m": {"type": "number", "exclusiveMinimum": 0},
            "far_m": {"type": "number", "exclusiveMinimum": 0},
            "rig_from_sensor": {"$ref": "#/$defs/transform"}
          }
        },
        "modalities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modality", "sensor_uuid"],
            "properties": {
              "modality": {"enum": ["rgb", "depth", "semantic"]},
              "sensor_uuid": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listener_id", "attached_to", "rig_from_listener"],
      "properties": {
        "listener_id": {"const": "listener0"},
        "attached_to": {"const": "camera_rig_0"},
        "rig_from_listener": {"$ref": "#/$defs/transform"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "world_from_source"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "world_from_source": {"$ref": "#/$defs/transform"}
        }
      }
    },
    "qa_views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qa_id", "kind", "meters_per_pixel", "height_m"],
        "properties": {
          "qa_id": {"type": "string", "minLength": 1},
          "kind": {"const": "topdown"},
          "meters_per_pixel": {"type": "number", "exclusiveMinimum": 0},
          "height_m": {"type": "number"}
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_m", "rotation_xyzw"],
      "properties": {
        "translation_m": {"$ref": "#/$defs/vec3"},
        "rotation_xyzw": {"$ref": "#/$defs/quat"}
      }
    }
  }
}
