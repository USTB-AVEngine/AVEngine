{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m2_human_visual_review_v1.schema.json",
  "title": "AVEngine M2 Human Visual Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "scope",
    "qualification_claim",
    "formal_dataset_registration_authorized",
    "candidate",
    "capture",
    "world_contact_audit",
    "review_media",
    "diagnostic_media",
    "source_license",
    "reviewer_decision",
    "decision_reason"
  ],
  "properties": {
    "schema": {"const": "avengine_m2_human_visual_review_v1"},
    "status": {"const": "pass"},
    "scope": {"const": "m2_canary_admission"},
    "qualification_claim": {"const": false},
    "formal_dataset_registration_authorized": {"const": false},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "admission_state", "asset_manifest"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "admission_state": {"const": "research_candidate"},
        "asset_manifest": {"$ref": "#/$defs/artifact"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "state_count",
        "review_only",
        "asset_manifest_sha256",
        "request",
        "evidence"
      ],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "state_count": {"const": 75},
        "review_only": {"const": true},
        "asset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "request": {"$ref": "#/$defs/artifact"},
        "evidence": {"$ref": "#/$defs/artifact"}
      }
    },
    "world_contact_audit": {"$ref": "#/$defs/artifact"},
    "review_media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb", "depth", "semantic"],
      "properties": {
        "rgb": {"$ref": "#/$defs/artifact"},
        "depth": {"$ref": "#/$defs/artifact"},
        "semantic": {"$ref": "#/$defs/artifact"}
      }
    },
    "diagnostic_media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "artifact"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "source_license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_revision",
        "license",
        "allowed_use",
        "redistribution",
        "license_file",
        "readme_file"
      ],
      "properties": {
        "source_repository": {
          "const": "https://github.com/microsoft/Microsoft-Rocketbox.git"
        },
        "source_revision": {"type": "string", "minLength": 1},
        "license": {"const": "MIT"},
        "allowed_use": {"const": "research_canary"},
        "redistribution": {"const": "allowed"},
        "license_file": {"$ref": "#/$defs/artifact"},
        "readme_file": {"$ref": "#/$defs/artifact"}
      }
    },
    "reviewer_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "decision_date",
        "statement",
        "overall_canary_visual_acceptance",
        "rear_leg_motion_naturalness"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "decision_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "statement": {"type": "string", "minLength": 1},
        "overall_canary_visual_acceptance": {"const": "pass"},
        "rear_leg_motion_naturalness": {"const": "pass"}
      }
    },
    "decision_reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
