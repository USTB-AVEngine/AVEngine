{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/source_asset_runtime_registry_v1.schema.json",
  "title": "AVEngine Source Asset Runtime Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "revision",
    "aliases",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "avengine_source_asset_runtime_registry_v1"
    },
    "registry_id": {
      "$ref": "#/$defs/stable_id"
    },
    "revision": {
      "$ref": "#/$defs/stable_id"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/asset_ref"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "root_id": {
          "$ref": "#/$defs/stable_id"
        },
        "path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "local_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "forward_axis",
        "up_axis",
        "right_axis",
        "handedness"
      ],
      "properties": {
        "schema": {
          "const": "avengine_asset_local_basis_v1"
        },
        "forward_axis": {
          "$ref": "#/$defs/vec3"
        },
        "up_axis": {
          "$ref": "#/$defs/vec3"
        },
        "right_axis": {
          "$ref": "#/$defs/vec3"
        },
        "handedness": {
          "const": "forward_cross_up_equals_right"
        }
      }
    },
    "asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "revision"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/stable_id"
        },
        "revision": {
          "$ref": "#/$defs/stable_id"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species_id",
        "breed_id"
      ],
      "properties": {
        "species_id": {
          "$ref": "#/$defs/stable_id"
        },
        "breed_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/stable_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "coat_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "value"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/stable_id"
        },
        "value": {
          "$ref": "#/$defs/stable_id"
        }
      }
    },
    "realized_attributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "body_build": {
          "enum": [
            "slim",
            "standard",
            "stocky"
          ]
        },
        "life_stage": {
          "$ref": "#/$defs/stable_id"
        },
        "coat_profile": {
          "$ref": "#/$defs/coat_profile"
        }
      }
    },
    "generation_request_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "body_build",
        "life_stage"
      ],
      "properties": {
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "body_build": {
          "enum": [
            "slim",
            "standard",
            "stocky"
          ]
        },
        "life_stage": {
          "enum": [
            "young",
            "adult",
            "senior"
          ]
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mesh_authority",
        "source_mesh_uri"
      ],
      "properties": {
        "mesh_authority": {
          "enum": [
            "generated_pixel3d_target_native",
            "audited_library_asset",
            "rigid_or_environmental_asset"
          ]
        },
        "source_mesh_uri": {
          "$ref": "#/$defs/nonempty_string"
        },
        "rig_authority": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "body_plan_id",
        "local_anatomical_forward_axis",
        "walk_phase_period_frames",
        "idle_action_id",
        "walking_action_id"
      ],
      "properties": {
        "template_id": {
          "$ref": "#/$defs/stable_id"
        },
        "body_plan_id": {
          "$ref": "#/$defs/stable_id"
        },
        "local_anatomical_forward_axis": {
          "$ref": "#/$defs/vec3"
        },
        "walk_phase_period_frames": {
          "type": "integer",
          "minimum": 1
        },
        "idle_action_id": {
          "$ref": "#/$defs/stable_id"
        },
        "walking_action_id": {
          "$ref": "#/$defs/stable_id"
        }
      }
    },
    "emitter_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "anchor_type",
        "offset_m",
        "offset_space"
      ],
      "properties": {
        "anchor_id": {
          "$ref": "#/$defs/stable_id"
        },
        "anchor_type": {
          "enum": [
            "mouth",
            "muzzle",
            "head",
            "body",
            "object_speaker",
            "environmental_point"
          ]
        },
        "offset_m": {
          "$ref": "#/$defs/vec3"
        },
        "offset_space": {
          "const": "final_scaled_asset_root"
        },
        "local_basis": {
          "$ref": "#/$defs/local_basis"
        }
      }
    },
    "component_frame_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rotation_deg",
        "translation_cm",
        "composition",
        "reason"
      ],
      "properties": {
        "schema": {
          "const": "avengine_spear_component_frame_delta_v1"
        },
        "rotation_deg": {
          "$ref": "#/$defs/vec3"
        },
        "translation_cm": {
          "$ref": "#/$defs/vec3"
        },
        "composition": {
          "const": "add_relative_preserving_blueprint_transform"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "anatomical_basis_bones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rear",
        "front",
        "body",
        "left_foot",
        "right_foot"
      ],
      "properties": {
        "rear": {
          "$ref": "#/$defs/nonempty_string"
        },
        "front": {
          "$ref": "#/$defs/nonempty_string"
        },
        "body": {
          "$ref": "#/$defs/nonempty_string"
        },
        "left_foot": {
          "$ref": "#/$defs/nonempty_string"
        },
        "right_foot": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "spear_unreal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_class_path",
        "skeletal_mesh_binding",
        "skeletal_mesh_path",
        "idle_animation",
        "walking_animation",
        "ue_anatomical_forward_yaw_deg",
        "ue_component_frame_delta",
        "floor_contact_gate"
      ],
      "properties": {
        "blueprint_class_path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "skeletal_mesh_binding": {
          "enum": [
            "blueprint_component",
            "explicit_path"
          ]
        },
        "skeletal_mesh_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ue_import_manifest_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "schema",
            "tag",
            "import_asset_id"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/"
            },
            "schema": {
              "$ref": "#/$defs/nonempty_string"
            },
            "tag": {
              "$ref": "#/$defs/nonempty_string"
            },
            "import_asset_id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "base_avatar_id": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        "idle_animation": {
          "$ref": "#/$defs/nonempty_string"
        },
        "walking_animation": {
          "$ref": "#/$defs/nonempty_string"
        },
        "animation_paths_by_action_id": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "$ref": "#/$defs/stable_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "ue_anatomical_forward_yaw_deg": {
          "type": "number"
        },
        "ue_anatomical_basis_bones": {
          "$ref": "#/$defs/anatomical_basis_bones"
        },
        "ue_component_frame_delta": {
          "$ref": "#/$defs/component_frame_delta"
        },
        "floor_contact_gate": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "skeletal_mesh_binding": {
                "const": "explicit_path"
              }
            }
          },
          "then": {
            "properties": {
              "skeletal_mesh_path": {
                "$ref": "#/$defs/nonempty_string"
              }
            }
          }
        }
      ]
    },
    "static_spear_unreal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_mesh_binding",
        "static_mesh_object_path",
        "actor_scale",
        "ue_static_forward_yaw_deg"
      ],
      "properties": {
        "static_mesh_binding": {
          "const": "explicit_path"
        },
        "static_mesh_object_path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "actor_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ue_static_forward_yaw_deg": {
          "type": "number"
        }
      }
    },
    "runtime_backends": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "spear_unreal": {
          "oneOf": [
            {
              "$ref": "#/$defs/spear_unreal_binding"
            },
            {
              "$ref": "#/$defs/static_spear_unreal_binding"
            }
          ]
        }
      }
    },
    "source_asset_v2_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "asset_id",
        "profile_schema_id",
        "profile_sha256",
        "request_sha256",
        "lineage_group_id",
        "state_classification",
        "record",
        "registry"
      ],
      "properties": {
        "schema": {
          "const": "source_asset_v2"
        },
        "asset_id": {
          "$ref": "#/$defs/stable_id"
        },
        "profile_schema_id": {
          "$ref": "#/$defs/stable_id"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lineage_group_id": {
          "$ref": "#/$defs/stable_id"
        },
        "state_classification": {
          "enum": [
            "formal_dataset_asset",
            "research_candidate",
            "technical_spike_only",
            "rejected"
          ]
        },
        "record": {
          "$ref": "#/$defs/artifact_ref"
        },
        "registry": {
          "$ref": "#/$defs/artifact_ref"
        }
      }
    },
    "pixel3d_geometry_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_kind",
        "raw_pixel3d_glb",
        "tokenrig_input_glb",
        "runtime_mesh_uri",
        "runtime_glb",
        "repair_evidence"
      ],
      "properties": {
        "lineage_kind": {
          "enum": [
            "unchanged_pixel3d_geometry",
            "bounded_same_pixel3d_mesh_repair"
          ]
        },
        "raw_pixel3d_glb": {
          "$ref": "#/$defs/artifact_ref"
        },
        "tokenrig_input_glb": {
          "$ref": "#/$defs/artifact_ref"
        },
        "runtime_mesh_uri": {
          "$ref": "#/$defs/nonempty_string"
        },
        "runtime_glb": {
          "$ref": "#/$defs/artifact_ref"
        },
        "repair_evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lineage_kind": {
                "const": "unchanged_pixel3d_geometry"
              }
            }
          },
          "then": {
            "properties": {
              "repair_evidence": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lineage_kind": {
                "const": "bounded_same_pixel3d_mesh_repair"
              }
            }
          },
          "then": {
            "properties": {
              "repair_evidence": {
                "$ref": "#/$defs/artifact_ref"
              }
            }
          }
        }
      ]
    },
    "asset_admission_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "formal_dataset_registration_authorized",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "research",
            "qualified",
            "formal",
            "unavailable",
            "rejected"
          ]
        },
        "formal_dataset_registration_authorized": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "asset_bound_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "runtime_asset_id",
        "runtime_revision",
        "source_asset_v2",
        "geometry",
        "tokenrig_animation_closure",
        "ue_asset_bound_import_evidence",
        "ue_runtime_readback_evidence",
        "emitter_measurement_evidence",
        "admission"
      ],
      "properties": {
        "schema": {
          "const": "avengine_spear_source_asset_v2_runtime_lineage_v1"
        },
        "runtime_asset_id": {
          "$ref": "#/$defs/stable_id"
        },
        "runtime_revision": {
          "$ref": "#/$defs/stable_id"
        },
        "source_asset_v2": {
          "$ref": "#/$defs/source_asset_v2_binding"
        },
        "geometry": {
          "$ref": "#/$defs/pixel3d_geometry_lineage"
        },
        "tokenrig_animation_closure": {
          "$ref": "#/$defs/artifact_ref"
        },
        "ue_asset_bound_import_evidence": {
          "$ref": "#/$defs/artifact_ref"
        },
        "ue_runtime_readback_evidence": {
          "$ref": "#/$defs/artifact_ref"
        },
        "emitter_measurement_evidence": {
          "$ref": "#/$defs/artifact_ref"
        },
        "admission": {
          "$ref": "#/$defs/asset_admission_binding"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "revision",
        "display_label",
        "entity_class",
        "identity",
        "realized_attributes",
        "geometry",
        "default_emitter_anchor_id",
        "emitter_anchors",
        "runtime_backends",
        "admission_state"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/stable_id"
        },
        "revision": {
          "$ref": "#/$defs/stable_id"
        },
        "display_label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "entity_class": {
          "enum": [
            "articulated_human",
            "articulated_animal",
            "rigid_object",
            "environmental_emitter"
          ]
        },
        "identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "$ref": "#/$defs/rigid_identity"
            }
          ]
        },
        "realized_attributes": {
          "$ref": "#/$defs/realized_attributes"
        },
        "generation_request_attributes": {
          "$ref": "#/$defs/generation_request_attributes"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "default_emitter_anchor_id": {
          "$ref": "#/$defs/stable_id"
        },
        "emitter_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/emitter_anchor"
          }
        },
        "runtime_backends": {
          "$ref": "#/$defs/runtime_backends"
        },
        "asset_bound_lineage": {
          "$ref": "#/$defs/asset_bound_lineage"
        },
        "admission_state": {
          "enum": [
            "research",
            "qualified",
            "formal",
            "unavailable",
            "rejected"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_class": {
                "const": "rigid_object"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "required": [
                  "mesh_authority",
                  "source_mesh_uri"
                ]
              },
              "runtime_backends": {
                "required": [
                  "spear_unreal"
                ],
                "properties": {
                  "spear_unreal": {
                    "$ref": "#/$defs/static_spear_unreal_binding"
                  }
                }
              },
              "emitter_anchors": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "anchor_type": {
                      "const": "object_speaker"
                    }
                  },
                  "required": [
                    "anchor_type"
                  ]
                }
              },
              "identity": {
                "$ref": "#/$defs/rigid_identity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_class": {
                "const": "rigid_object"
              }
            }
          },
          "else": {
            "required": [
              "timeline"
            ],
            "properties": {
              "geometry": {
                "required": [
                  "mesh_authority",
                  "source_mesh_uri",
                  "rig_authority"
                ]
              },
              "runtime_backends": {
                "properties": {
                  "spear_unreal": {
                    "$ref": "#/$defs/spear_unreal_binding"
                  }
                }
              },
              "identity": {
                "$ref": "#/$defs/identity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_class": {
                "const": "articulated_animal"
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {
                  "breed_id": {
                    "$ref": "#/$defs/stable_id"
                  }
                }
              },
              "realized_attributes": {
                "required": [
                  "size",
                  "body_build",
                  "life_stage",
                  "coat_profile"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admission_state": {
                "const": "formal"
              }
            }
          },
          "then": {
            "required": [
              "asset_bound_lineage"
            ]
          }
        }
      ]
    },
    "rigid_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "category"
      ],
      "properties": {
        "object_type": {
          "$ref": "#/$defs/stable_id"
        },
        "category": {
          "$ref": "#/$defs/stable_id"
        }
      }
    }
  }
}
