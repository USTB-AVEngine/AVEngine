{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avengine.local/schema/m6x_anchor_library_v1.schema.json",
  "title": "AVEngine M6.x Fixed Room Anchor Library v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "anchor_library_id",
    "revision",
    "room_capsule_ref",
    "coordinate_frame",
    "anchors",
    "execution_status"
  ],
  "properties": {
    "schema": {"const": "avengine_m6x_anchor_library_v1"},
    "anchor_library_id": {"$ref": "#/$defs/stable_id"},
    "revision": {"$ref": "#/$defs/stable_id"},
    "room_capsule_ref": {"$ref": "#/$defs/revision_ref"},
    "coordinate_frame": {"const": "avengine_world_right_handed_y_up_m"},
    "anchors": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/anchor"}
    },
    "execution_status": {"$ref": "#/$defs/execution_status"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room_capsule_id", "revision"],
      "properties": {
        "room_capsule_id": {"$ref": "#/$defs/stable_id"},
        "revision": {"$ref": "#/$defs/stable_id"}
      }
    },
    "execution_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["run", "pass", "blocked", "not_run"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "blocked"}},
            "required": ["state"]
          },
          "then": {"required": ["reason", "evidence_refs"]}
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "kind",
        "position_m",
        "yaw_deg",
        "listener_relative_sector",
        "expected_camera_fov",
        "expected_acoustic_path",
        "validation_status"
      ],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/stable_id"},
        "kind": {
          "enum": [
            "camera_listener_pose",
            "entity_spawn",
            "trajectory_waypoint",
            "world_source"
          ]
        },
        "position_m": {"$ref": "#/$defs/vec3"},
        "yaw_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "listener_relative_sector": {
          "enum": [
            "front",
            "front_left",
            "front_right",
            "left",
            "right",
            "rear",
            "rear_left",
            "rear_right",
            "not_applicable"
          ]
        },
        "expected_camera_fov": {
          "enum": ["in_fov", "out_of_fov", "not_applicable"]
        },
        "expected_acoustic_path": {
          "enum": ["los", "nlos", "not_evaluated", "not_applicable"]
        },
        "los_probe_height_m": {"type": "number", "minimum": 0},
        "validation_status": {"$ref": "#/$defs/execution_status"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "camera_listener_pose"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "listener_relative_sector": {"const": "not_applicable"},
              "expected_camera_fov": {"const": "not_applicable"},
              "expected_acoustic_path": {"const": "not_applicable"}
            }
          },
          "else": {
            "required": ["los_probe_height_m"],
            "properties": {
              "listener_relative_sector": {"not": {"const": "not_applicable"}},
              "expected_camera_fov": {"not": {"const": "not_applicable"}},
              "expected_acoustic_path": {"not": {"const": "not_applicable"}}
            }
          }
        }
      ]
    }
  }
}
