{
  "schema": "avengine_m3_acoustic_canary_request_v1",
  "request_id": "m3_blender_custom_material_extremes_v1",
  "room_manifest": "${AVENGINE_REPOSITORY_ROOT}/examples/rooms/blender_custom/room_manifest.json",
  "material_mapping": "mapping.json",
  "material_databases": {
    "low_absorption": "materials_low.json",
    "high_absorption": "materials_high.json"
  },
  "listener": {
    "id": "listener0",
    "position_m": [-2.5, 1.55, 0.0],
    "radius_m": 0.0
  },
  "source": {
    "id": "source0",
    "position_m": [-1.2, 0.3, -1.0],
    "radius_m": 0.0
  },
  "repeat_count": 3,
  "simulation": {
    "sample_rate_hz": 16000,
    "max_ir_seconds": 4.0,
    "frequency_bands": 4,
    "direct_sh_order": 3,
    "indirect_sh_order": 1,
    "direct_ray_count": 500,
    "indirect_ray_count": 5000,
    "indirect_ray_depth": 100,
    "source_ray_count": 500,
    "source_ray_depth": 20,
    "max_diffraction_order": 10,
    "thread_count": 1,
    "unit_scale": 1.0,
    "global_volume": 1.0,
    "speed_of_sound_m_s": 343.0,
    "direct": true,
    "indirect": true,
    "diffraction": true,
    "transmission": false,
    "mesh_simplification": false,
    "temporal_coherence": false,
    "channel_layout": {
      "type": "mono",
      "channel_count": 1
    }
  },
  "thresholds": {
    "geometry_bytes_identical": true,
    "material_ids_identical": true,
    "material_coverage_fraction": 1.0,
    "fallback_triangle_count": 0,
    "ray_checks": {
      "require_nonempty": true,
      "maximum_first_hit_distance_error_m": 0.0001
    },
    "direct_arrival": {
      "maximum_absolute_error_samples": 2.0
    },
    "metrics": {
      "edt_seconds": {
        "direction": "high_lt_low",
        "minimum_absolute_effect": 0.05,
        "maximum_relative_repeat_spread": 0.1,
        "minimum_effect_to_within_spread_ratio": 2.0,
        "minimum_fit_r2": 0.9,
        "minimum_decay_span_db": 10.0
      },
      "drr_db": {
        "direction": "high_gt_low",
        "minimum_absolute_effect": 1.0,
        "maximum_relative_repeat_spread": 0.1,
        "minimum_effect_to_within_spread_ratio": 2.0
      },
      "late_energy_ratio": {
        "direction": "high_lt_low",
        "minimum_absolute_effect": 0.05,
        "minimum_effect_ratio": 1.2,
        "maximum_relative_repeat_spread": 0.1,
        "minimum_effect_to_within_spread_ratio": 2.0
      }
    }
  }
}
